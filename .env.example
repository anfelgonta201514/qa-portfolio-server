# Copiar a .env (gitignorado) y completar con valores reales.
# En el servidor, .env vive junto a docker-compose.yml.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Firma las cookies de sesión de Flask-Login. Generar con:
#   openssl rand -hex 32
SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Demos de IA en vivo (APAGADOS: sin AI_PROVIDER el sitio muestra los ejemplos
# pregenerados). Ver README, "Capa de proveedor de IA".
#
# ANTES de activarlos hace falta, además de completar esto:
#   1. (Hecho) Groq ya está registrado en app/ai_provider.py.
#   2. Pasar estas variables al contenedor `app` en docker-compose.yml: el
#      compose solo entrega las variables que lista, así que sin ese paso
#      la app NO las ve aunque estén en este archivo.
#   3. Poner Gunicorn con hilos (hoy: 1 worker síncrono, una llamada lenta al
#      proveedor bloquea todo el sitio mientras espera).
# La clave es un SECRETO: solo en el .env del servidor, nunca en el repo.
# ---------------------------------------------------------------------------
# Proveedor elegido: Groq (ver docs/proveedores-ia.md). Modelo sugerido para empezar:
#   openai/gpt-oss-20b  (mismos límites gratis que el 120b según la página oficial)
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# AI_API_KEY=
#
# Límites (valores por defecto; un valor inválido vuelve al por defecto):
# AI_RATE_LIMIT_PER_VISITOR=5     peticiones por visitante dentro de la ventana
# AI_RATE_WINDOW_SECONDS=600      ventana deslizante en segundos
# AI_DAILY_CAP=100                tope diario global (día UTC) de llamadas al proveedor.
#                                 Con Groq gratis (200.000 tokens/día) conviene EMPEZAR EN 60 y
#                                 ajustar con el consumo real: 100 se pasaría del límite del plan.
# AI_MAX_INPUT_CHARS=4000         entrada más larga se rechaza (no se trunca)
# AI_MAX_OUTPUT_TOKENS=1200       tope de la respuesta del proveedor
# AI_TIMEOUT_SECONDS=15           espera máxima por llamada
